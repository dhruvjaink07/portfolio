{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dhruvjain",
  "pages_build_output_dir": "out",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Must be the Resend account's email: without a verified domain, Resend only delivers there.
  // RESEND_API_KEY is a secret: `npx wrangler pages secret put RESEND_API_KEY --project-name dhruvjain`.
  "vars": {
    "CONTACT_TO_EMAIL": "dhruvkishorjain2508@gmail.com"
  }
}
